# Copy to .env for local reference. These keys are NOT bundled into the
# extension — they're entered at runtime via the Options page and stored in
# chrome.storage.local. This file just documents what you'll need.

# Anthropic API key — required. Starts with sk-ant-
ANTHROPIC_KEY=sk-ant-...

# eBay App ID (Client ID) — optional. Enables real sold-listings pricing.
EBAY_APP_ID=YourApp-...
