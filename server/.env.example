# Copy to server/.env. Never commit the real file.

# Anthropic API key. Lives only on the server.
ANTHROPIC_API_KEY=sk-ant-...

# Daily spending cap in USD, across all tokens. Required: the server won't start
# without it. Choose your own value.
DAILY_BUDGET_USD=

# Optional. These are the defaults.
# HOST=127.0.0.1
# PORT=3000
# DB_PATH=data/dealscan.db
# CACHE_TTL_SECONDS=3600
# RATE_LIMIT_PER_MINUTE=30
