# Secrets — never commit real keys.
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build / packaging output
dist/
build/
*.zip

# Raw, unedited screenshot originals — the resized store-ready copies are kept,
# these large source files are not.
store-assets/screenshots/raw/

# Saved Facebook pages. Raw HTML holds session data and real people's details,
# and must never be committed. Sanitized output waits in review until it's read.
tests/fixtures/raw/
tests/fixtures/review/

# Server database
server/data/

# Mock eval runs: their numbers mean nothing
eval/results/*-MOCK.json

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp

# Test coverage
coverage/

# Local AI assistant context: private notes and settings (CLAUDE.md is tracked)
CLAUDE.local.md
.claude/
